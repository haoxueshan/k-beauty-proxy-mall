SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
ALLOWED_ORIGINS=https://mall.example.com
TRUSTED_HOSTS=mall.example.com,www.mall.example.com
OPENAI_API_KEY=sk-your_openai_api_key
APP_ENV=production
LOG_LEVEL=INFO

# BaoTa/Supervisor usually runs FastAPI behind Nginx on localhost.
HOST=127.0.0.1
PORT=8000
PORT_AUTO_FALLBACK=false
UVICORN_RELOAD=false

# Optional Olive Young crawler proxy for servers whose outbound IP is blocked or unstable.
# Example: http://127.0.0.1:7890 or http://user:pass@proxy.example.com:8080
CRAWLER_PROXY_SERVER=
CRAWLER_PROXY_USERNAME=
CRAWLER_PROXY_PASSWORD=
