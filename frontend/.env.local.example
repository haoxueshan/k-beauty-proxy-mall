# Same-domain BaoTa/Nginx deployment: leave empty so the browser calls /api on the current domain.
NEXT_PUBLIC_API_BASE_URL=

# Optional: let Next.js proxy /api to FastAPI when Nginx does not proxy /api directly.
# Local development can also use this and keep NEXT_PUBLIC_API_BASE_URL empty.
API_PROXY_TARGET=http://127.0.0.1:8000

# Server-side rendering needs an absolute internal backend URL.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# Alternative: use a separate API domain instead of same-domain /api.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
